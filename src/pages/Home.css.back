.about-section {
  padding: 60px 20px;
  background-color: #ffffff;
  text-align: center;
}

.about-container {
  max-width: 800px;
  margin: 0 auto;
}

.about-title {
  font-size: 2.5rem;
  margin-bottom: 20px;
  color: #333;
}

.about-description {
  font-size: 1.2rem;
  line-height: 1.6;
  color: #666;
}
